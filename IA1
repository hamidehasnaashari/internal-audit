const v14esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const v14riskControls=(rid,pr=P())=>pr.controls.filter(c=>(c.risks||control(c.id)?.risks||[]).includes(rid));
const v14evals=(rid,cid,pr=P())=>pr.controlEvaluations.filter(e=>!!e.programId&&(!rid||e.risk===rid)&&(!cid||e.control===cid));
const v14avg=a=>a.length?a.reduce((x,y)=>x+y,0)/a.length:null;
const v14evalRating=e=>(+e.design + +e.implementation + +e.operating)/3;
function v14RiskStats(r,pr=P()){
 const ctrls=v14riskControls(r.id,pr), allE=ctrls.flatMap(c=>v14evals(r.id,c.id,pr));
 const assessed=allE.filter(e=>+e.design>0&&+e.implementation>0&&+e.operating>0);
 const avg=v14avg(assessed.map(v14evalRating));
 const cr=avg===null?null:Math.max(1,Math.min(5,Math.round(6-avg)));
 function dimAvg(flag){const list=ctrls.filter(c=>!!(c[flag]??control(c.id)?.[flag])).flatMap(c=>v14evals(r.id,c.id,pr).filter(e=>+e.design>0&&+e.implementation>0&&+e.operating>0).map(v14evalRating));return v14avg(list)}
 const pAvg=dimAvg('prob'),iAvg=dimAvg('impact');
 const reduction=x=>x===null?0:((Math.max(1,Math.min(5,x))-1)/4)*.6;
 const rl=pAvg===null?r.l:Math.max(1,Math.ceil(r.l*(1-reduction(pAvg))));
 const ri=iAvg===null?r.i:Math.max(1,Math.ceil(r.i*(1-reduction(iAvg))));
 const residualScore=rl*ri;
 return {inherentScore:r.l*r.i,controlRisk:cr,controlAvg:avg,residualL:rl,residualI:ri,residualScore,assessmentCount:assessed.length,controlCount:ctrls.length,unassessed:ctrls.length===0||assessed.length===0};
}
function v14ControlStatus(cid,pr=P()){const ev=pr.controlEvaluations.filter(e=>e.control===cid&&!!e.programId);if(!ev.length)return {design:'—',implementation:'—',operating:'—',count:0,weak:true};const d=v14avg(ev.map(e=>+e.design).filter(Boolean)),i=v14avg(ev.map(e=>+e.implementation).filter(Boolean)),o=v14avg(ev.map(e=>+e.operating).filter(Boolean));return {design:d===null?'—':d.toFixed(1),implementation:i===null?'—':i.toFixed(1),operating:o===null?'—':o.toFixed(1),count:ev.length,weak:[d,i,o].some(x=>x!==null&&x<3)};}
function v14DetailsButton(type,id){return `<button class="detailbtn" data-showtype="${type}" data-showid="${v14esc(id)}">نمایش</button>`}
function v14BandScore(s){return s>=16?'high':s>=9?'med':'low'}
function v14RiskScoreTag(s){return `<span class="tag ${v14BandScore(s)}">${s}/۲۵ · ${s>=16?'بالا':s>=9?'متوسط':'پایین'}</span>`}
function v14ProjectRiskRows(master){let out=[];db.projects.forEach(pr=>pr.risks.filter(x=>x.id===master.id).forEach(r=>out.push({project:pr,r,stats:v14RiskStats(r,pr)})));return out}
function v14objectiveMetrics(objId,pr){const objRiskIds=pr.risks.filter(r=>r.obj===objId).map(r=>r.id);const rs=pr.risks.filter(r=>r.obj===objId);const controls=pr.controls.filter(c=>(c.risks||control(c.id)?.risks||[]).some(id=>objRiskIds.includes(id)));const max=rs.length?Math.max(...rs.map(r=>v14RiskStats(r,pr).residualScore)):0;return {risks:rs.length,controls:controls.length,residual:max,rs,controls}} 

