    const related=projectRiskEntries20(r.id),inherent=related.map(x=>x.r.l*x.r.i),control=related.map(x=>x.res.score),controls=[...new Set(db.controls.filter(c=>(c.risks||[]).includes(r.id)).map(c=>c.id))],objectives=r.obj||[],projects=[...new Set(related.map(x=>x.p.id))],avg=key=>{const v=related.map(x=>+x.r[key]||0);return v.length?(v.reduce((a,b)=>a+b,0)/v.length).toFixed(1):'—';};
    return `<tr><td><b>${r.code}</b><div class="small muted">${r.cat||'—'}</div></td><td><b>${r.name}</b><div class="small muted">${r.desc}</div></td><td>${r.cat||'—'}</td><td>${avg('l')} / ۵<br>${riskDistribution5(related.map(x=>x.r.l))}</td><td>${avg('i')} / ۵<br>${riskDistribution5(related.map(x=>x.r.i))}</td><td>${riskDistribution20(inherent)}<br><span class="tag ${band(inherent.length?Math.max(...inherent):0)}">${riskLevelText(inherent.length?Math.max(...inherent):0)}</span></td><td>${riskDistribution20(control)}<br><span class="tag ${band(control.length?Math.max(...control):0)}">${riskLevelText(control.length?Math.max(...control):0)}</span></td><td><b>${controls.length}</b><div class="small muted">${controls.map(id=>control(id)?.code||id).join('، ')||'—'}</div></td><td><b>${objectives.length}</b><div class="small muted">${objectives.map(id=>obj(id)?.name||id).join('، ')||'—'}</div></td><td><b>${projects.length}</b></td><td><span class="small">علت: ${r.causes}<br>پیامد: ${r.effect}</span></td></tr>`;
  });
  return `${header('مخزن ریسک‌های سازمانی','ریسک‌ها به دسته، اهداف و کنترل‌ها متصل‌اند؛ میانگین احتمال و اثر و توزیع خطرهای ذاتی و کنترلی از پروژه‌های مرتبط محاسبه می‌شود.','<button id="addRisk">+ ریسک جدید</button>')}${table(['کد / دسته','ریسک','دسته','میانگین احتمال','میانگین اثر','خطر ذاتی','خطر کنترل','کنترل‌های مرتبط','اهداف مرتبط','پروژه‌های مرتبط','علل و پیامد'],rows)}<div class="notice">نمودارهای کلوچه‌ای هر ردیف، تعداد ارزیابی‌های پایین، متوسط و بالا را برای احتمال/اثر و خطر ذاتی/کنترل نشان می‌دهند. مبنای خطر کنترل، ریسک باقیمانده پس از اعمال کنترل‌های پروژه است.</div>`;
}
function controls(){return `${header('مخزن کنترل‌های سازمانی','کنترل‌ها به ریسک‌های سازمانی متصل‌اند؛ اثر کنترل بر احتمال و/یا شدت پیامد مشخص می‌شود.','<button id="addControl">+ کنترل جدید</button>')}${table(['کد و کنترل','نوع/ماهیت/تناوب','مالک','ریسک‌های مرتبط','اثر کنترل'],db.controls.map(c=>`<tr><td><b>${c.code} · ${c.name}</b><div class="small muted">${c.desc}</div></td><td>${c.type} / ${c.nature}<br>${c.freq}</td><td>${c.owner}</td><td>${c.risks.map(id=>`<span class="tag">${risk(id)?.code||id}</span>`).join(' ')}<div class="small muted">${db.projects.filter(p=>p.controls.some(x=>x.id===c.id)).length} پروژه متصل</div></td><td>${c.prob?'کاهش احتمال ':''}${c.impact?'کاهش اثر':''}</td></tr>`))}<div class="notice">کنترل می‌تواند احتمال وقوع، شدت اثر یا هر دو را کاهش دهد. این ویژگی در محاسبه ریسک باقیمانده لحاظ می‌شود و باید بر اساس طراحی واقعی کنترل مستند شود.</div>`}
const checklist=[['complexity','پیچیدگی فرایند و تعداد نقاط تصمیم'],['volume','حجم و تعداد تراکنش‌ها'],['change','تغییرات اخیر، سامانه یا ساختار جدید'],['judgement','میزان قضاوت و برآورد مدیریت'],['external','وابستگی به اشخاص ثالث و عوامل بیرونی'],['fraud','آسیب‌پذیری در برابر تقلب و تبانی'],['regulation','حساسیت قانونی و مقرراتی'],['prior','سابقه خطا، شکایت یا یافته قبلی']];
function assessment(){let p=P();return `${header('اهداف و ارزیابی خطر ذاتی','انتخاب هدف از مخزن، اختصاصی‌سازی شرح در پروژه و ارزیابی مستقل احتمال و اثر','<button id="addProjectObjective">+ افزودن هدف به پروژه</button>')}<div class="notice">چک‌لیست عوامل خطر برای هر هدف تکمیل می‌شود؛ امتیازهای عوامل ورودی قضاوت حرفه‌ای هستند و جایگزین ارزیابی احتمال و اثر ریسک‌های مرتبط نمی‌شوند. هر پاسخ باید با دلیل یا مدرک پشتیبانی شود.</div>${p.objectives.map(o=>`<div class="card" style="margin:12px 0"><div class="sectionhead"><div><b>${obj(o.id)?.name||o.id}</b><p>${o.desc}</p></div><div class="actions"><span class="tag">${o.scope}</span><button class="secondary" data-calcobjective="${o.id}">▦ ماشین‌حساب خطر</button><button class="secondary" data-objdetail="${o.id}">مشخصات هدف و ریسک‌ها</button></div></div><div class="formgrid">${checklist.map(([k,l])=>`<div class="field"><label>${l} (۱ تا ۵)</label><select data-factor="${o.id}" data-key="${k}">${[1,2,3,4,5].map(n=>`<option ${o.answers?.[k]==n?'selected':''}>${n}</option>`).join('')}</select></div>`).join('')}</div><div class="field"><label>جمع‌بندی قضاوت حسابرس و مستندات</label><textarea data-rationale="${o.id}">${o.rationale||''}</textarea></div><div class="small muted">میانگین عوامل: ${((Object.values(o.answers||{}).reduce((a,b)=>a+(+b),0)/(Object.keys(o.answers||{}).length||1))).toFixed(1)} از ۵</div></div>`).join('')}${header('ارزیابی ریسک‌های مرتبط با اهداف','احتمال و اثر ذاتی هر ریسک در بستر همین پروژه ثبت می‌شود.','<button id="addProjectRisk">+ افزودن ریسک به پروژه</button>')}${table(['ریسک / هدف','احتمال','اثر','امتیاز ذاتی','سطح','مبنای ارزیابی','جزئیات / کاربرگ'],p.risks.map(r=>`<tr><td><b>${risk(r.id)?.name||r.id}</b><div class="small muted">هدف: ${obj(r.obj)?.name||r.obj}</div></td><td><select data-risk="${r.id}" data-rfield="l">${[1,2,3,4,5].map(n=>`<option ${n==r.l?'selected':''}>${n}</option>`).join('')}</select></td><td><select data-risk="${r.id}" data-rfield="i">${[1,2,3,4,5].map(n=>`<option ${n==r.i?'selected':''}>${n}</option>`).join('')}</select></td><td><b>${r.l*r.i}</b></td><td><span class="tag ${band(r.l*r.i)}">${labelBand(r.l*r.i)}</span></td><td>${r.rationale||'—'}</td><td><button class="secondary" data-riskdetail="${r.id}">مشخصات و نقشه</button> <button class="secondary" data-wpfor="risk:${r.id}">+ کاربرگ</button></td></tr>`))}`}
function riskmatrix(){let p=P();let rows=p.objectives.map(o=>{let rr=p.risks.filter(r=>r.obj===o.id),score=rr.length?Math.max(...rr.map(r=>r.l*r.i)):0;return `<tr><td><b>${obj(o.id)?.name||o.id}</b><div class="small muted">${o.desc}</div></td><td>${rr.length}</td><td>${rr.map(r=>`<div class="pillrow"><span class="tag ${band(r.l*r.i)}">${risk(r.id)?.name||r.id}: ${r.l}×${r.i}=${r.l*r.i}</span></div>`).join('')||'ریسکی متصل نشده'}</td><td>${score?`<span class="tag ${band(score)}">${labelBand(score)} · ${score}/۲۵</span>`:'—'}</td><td><button class="secondary" data-calcobjective="${o.id}">ماشین‌حساب عوامل</button> <button class="secondary" data-wpfor="objective:${o.id}">کاربرگ هدف</button></td></tr>`});return `${header('ماتریس اهداف و ریسک‌های پروژه','این ماتریس فقط رابطه هدف پروژه و ریسک ذاتی را نشان می‌دهد؛ ارزیابی کنترل در صفحه مستقل کنترل‌ها انجام می‌شود.')}<div class="notice">اولویت برنامه‌ریزی از سطح ریسک ذاتی، اهمیت هدف، دامنه و قضاوت حرفه‌ای حسابرس حاصل می‌شود. این ماتریس کنترل‌ها را وارد محاسبه ریسک ذاتی نمی‌کند.</div>${table(['هدف / زیرهدف پروژه','تعداد ریسک','ریسک‌های متصل و امتیاز ذاتی','بالاترین سطح خطر','اقدامات'],rows)}<div class="grid cols" style="margin-top:15px"><div class="card"><b>نقشه حرارتی ریسک ذاتی</b>${heatmap(p.risks.map(r=>({l:r.l,i:r.i})))}</div><div class="card"><b>پراکندگی ریسک به تفکیک هدف</b>${p.objectives.map(o=>{let n=p.risks.filter(r=>r.obj===o.id),v=n.length?Math.max(...n.map(r=>r.l*r.i)):0;return `<div class="field"><label>${obj(o.id)?.name||o.id} · ${n.length} ریسک</label><div class="riskbar"><i style="width:${v*4}%"></i></div><span class="small muted">بیشترین امتیاز: ${v||'بدون ارزیابی'}</span></div>`}).join('')}</div></div>`}
function rcm(){let p=P();let rows=p.controls.map(c=>{let master=c,related=(master?.risks||control(c.id)?.risks||[]).filter(id=>p.risks.some(r=>r.id===id));return `<tr><td><b>${master?.name||c.id}</b><div class="small muted">${master?.code||control(c.id)?.code||c.id} · ${control(c.id)?.type||''} · ${control(c.id)?.nature||''} · ${control(c.id)?.freq||''}</div></td><td>${related.map(id=>`<span class="tag">${risk(id)?.name||id}</span>`).join(' ')||'ریسک مرتبط در پروژه انتخاب نشده'}</td><td>${(master?.prob??control(c.id)?.prob)?'کاهش احتمال ':''}${(master?.impact??control(c.id)?.impact)?'کاهش شدت اثر':''}</td><td>طراحی: ${c.design||'—'} / استقرار: ${c.implementation||'—'} / عملکرد: ${c.operating||'—'}</td><td>${c.evidence||'—'}<div class="small muted">${c.rationale||''}</div></td><td><button class="secondary" data-evalprojectcontrol="${c.id}">ارزیابی کنترل</button> <button class="secondary" data-wpfor="control:${c.id}">کاربرگ ارزیابی</button></td></tr>`});return `${header('ماتریس ارتباط و ارزیابی کنترل‌ها','مستقل از ماتریس خطر ذاتی؛ کنترل‌ها بر اساس ریسک‌های هدف پروژه انتخاب و در اینجا ارزیابی می‌شوند.','<button id="addProjectControl">+ افزودن کنترل از مخزن</button>')}<div class="notice">این صفحه، ارزیابی طراحی، استقرار و اثربخشی عملیاتی کنترل‌ها را نگهداری می‌کند. امتیاز کنترل در ماتریس اهداف و ریسک‌های ذاتی وارد نمی‌شود. اثر کنترل بر احتمال یا شدت پیامد در محاسبه ریسک باقیمانده، با روش مصوب سازمان و پس از مستندسازی آزمون‌ها اعمال خواهد شد.</div>${table(['کنترل پروژه','ریسک‌های مرتبط در پروژه','نوع اثر','ارزیابی سه‌بعدی','شواهد و نتیجه','عملیات'],rows)}<div class="notice">کنترل‌های انتخاب‌شده از مخزن، با شناسه و شرح همان زمان در پروژه Snapshot می‌شوند. اصلاح بعدی مخزن نباید سوابق رسیدگی قبلی را تغییر دهد.</div>`}
function heatmap(data){let h='<div class="heat" style="margin-top:12px"><div class="axis">ا\nث\nر</div>'+[1,2,3,4,5].map(n=>`<div class="axis">${n}</div>`).join('');for(let i=5;i>=1;i--){h+=`<div class="axis">${i}</div>`;for(let l=1;l<=5;l++){let n=data.filter(x=>x.l===l&&x.i===i).length;let s=l*i;h+=`<div class="h${s<=4?1:s<=9?2:s<=14?3:s<=19?4:5}">${n||''}</div>`}}return h+'</div><div class="small muted">محور افقی: احتمال (۱ تا ۵) · محور عمودی: اثر (۱ تا ۵)</div>'}
function program(){let p=P();return `${header('برنامه آزمون کنترل‌های داخلی','برنامه ریسک‌محور با پیشنهاد دستیار؛ قابل بازبینی و ویرایش حسابرس و اتصال به کاربرگ','<button id="generatePrograms">✦ دستیار تدوین برنامه آزمون</button> <button id="addProgram">+ آزمون دستی</button>')}${table(['هدف/ریسک/کنترل','روش و معیار آزمون','جامعه و نمونه','مسئول/موعد','وضعیت','کاربرگ'],p.programs.map(t=>`<tr><td><b>${obj(t.obj)?.name||t.obj}</b><div class="small">${risk(t.risk)?.name||t.risk}</div><div class="small muted">${control(t.control)?.name||t.control}</div></td><td>${t.procedure}<div class="small muted">معیار: ${t.criteria||'—'}</div></td><td>${t.population||'—'}<br>${t.sampling||'—'} · ${t.sample||'—'}</td><td>${t.auditor||'—'}<br>${t.due||'—'}</td><td><span class="tag">${t.status}</span></td><td><button class="secondary" data-wpfor="test:${t.id}">ایجاد کاربرگ</button></td></tr>`))}`}
function workpapers(){let p=P();return `${header('کاربرگ‌ها و شواهد','هر کاربرگ به یک ردیف ارزیابی خطر ذاتی، ارزیابی کنترل یا آزمون برنامه متصل می‌شود.','<button id="addWorkpaper">+ کاربرگ جدید</button>')}${table(['شناسه/عنوان','نوع اتصال','شرح کار انجام‌شده','شواهد و استثنا','نتیجه','تهیه‌کننده/بازبین','وضعیت'],p.workpapers.map(w=>`<tr><td><b>${w.id} · ${w.title}</b></td><td>${w.link}</td><td>${w.work}</td><td>${w.evidence}<br><span class="small muted">استثنا: ${w.exceptions||'ندارد'}</span></td><td>${w.conclusion||'—'}</td><td>${w.preparer||'—'} / ${w.reviewer||'—'}</td><td><span class="tag">${w.status}</span></td></tr>`))}`}
function findings(){let p=P();return `${header('یافته‌ها و برنامه‌های اقدام','یافته‌ها از نتایج آزمون/کاربرگ منشأ می‌گیرند؛ هر یافته می‌تواند چند اقدام اصلاحی داشته باشد.','<button id="addFinding">+ ثبت یافته</button> <button id="addAction">+ اقدام اصلاحی</button>')}${table(['یافته','ریسک/کنترل','شرایط، معیار، علت و اثر','شدت/مالک','اقدامات اصلاحی'],p.findings.map(f=>`<tr><td><b>${f.title}</b><div class="small muted">${f.id} · ${f.wp||'بدون کاربرگ'}</div></td><td>${risk(f.risk)?.name||f.risk||'—'}<br>${control(f.control)?.name||f.control||'—'}</td><td>شرایط: ${f.condition}<br>معیار: ${f.criteria}<br>علت: ${f.cause}<br>اثر: ${f.effect}</td><td><span class="tag ${f.severity==='زیاد'?'high':f.severity==='متوسط'?'med':'low'}">${f.severity}</span><br>${f.owner}</td><td>${p.actions.filter(a=>a.finding===f.id).map(a=>`${a.title} (${a.progress}٪ · ${a.status})`).join('<hr>')||'—'}</td></tr>`))}${header('فهرست اقدامات اصلاحی','مالک، موعد، اولویت، درصد پیشرفت و مدرک اجرای اقدام')}${table(['اقدام','یافته','مالک','موعد','اولویت','پیشرفت','وضعیت','مدرک'],p.actions.map(a=>`<tr><td>${a.title}</td><td>${a.finding}</td><td>${a.owner}</td><td>${a.due}</td><td>${a.priority}</td><td><input type="number" min="0" max="100" value="${a.progress}" data-progress="${a.id}" style="width:65px">٪</td><td><select data-actionstatus="${a.id}">${['باز','در حال اجرا','آماده بررسی','بسته'].map(s=>`<option ${a.status===s?'selected':''}>${s}</option>`).join('')}</select></td><td>${a.evidence||'—'}</td></tr>`))}`}
function followup(){let p=P();return `${header('پیگیری و بستن اقدامات','ثبت آزمون مجدد، بررسی شواهد و تصمیم درباره بستن یا بازگشایی اقدام','<button id="addFollowup">+ ثبت پیگیری</button>')}${table(['اقدام','تاریخ بررسی','پیگیر','نتیجه آزمون مجدد','شرح و شواهد','تصمیم'],p.followups.map(f=>`<tr><td>${p.actions.find(a=>a.id===f.action)?.title||f.action}</td><td>${f.date}</td><td>${f.reviewer}</td><td>${f.result}</td><td>${f.notes}</td><td><span class="tag">${f.decision}</span></td></tr>`))}`}
function openObjectiveCalculator(oid){let o=P().objectives.find(x=>x.id===oid);if(!o)return;let form=checklist.map(([k,l])=>`<div class="field"><label>${l} (۱ تا ۵)</label><select name="${k}">${[1,2,3,4,5].map(n=>`<option value="${n}" ${+(o.answers?.[k]||3)===n?'selected':''}>${n}</option>`).join('')}</select><input name="why_${k}" placeholder="دلیل/شاهد این عامل" value="${(o.factorNotes?.[k]||'').replace(/"/g,'&quot;')}"></div>`).join('');modal('ماشین‌حساب عوامل خطر ذاتی · '+(obj(oid)?.name||oid),`<div class="notice">این ماشین‌حساب عوامل ریسک را برای هدف انتخاب‌شده ساختارمند می‌کند. امتیاز عوامل، جایگزین تعیین احتمال و اثر هر ریسک نیست؛ حسابرس باید امتیاز نهایی هر ریسک را جداگانه تعیین کند.</div><div class="formgrid">${form}</div>${field('rationale','جمع‌بندی قضاوت حرفه‌ای و شواهد','','textarea',true)}`,v=>{o.answers=o.answers||{};o.factorNotes=o.factorNotes||{};checklist.forEach(([k])=>{o.answers[k]=+v[k];o.factorNotes[k]=v['why_'+k]||''});o.rationale=v.rationale;save()})}
function bind(){document.querySelectorAll('#nav button').forEach(b=>b.onclick=()=>{page=b.dataset.page;$('#side').classList.remove('open');render()});$('#projectSelect').onchange=e=>{activeProject=e.target.value;render()};const cs=$('#companySelect');if(cs)cs.onchange=e=>{activeCompany=e.target.value;const match=db.projects.find(p=>(p.company||'گروه صنعتی گل‌گهر')===activeCompany);if(match)activeProject=match.id;render()};$('#menubtn').onclick=()=>$('#side').classList.toggle('open');$('#modalClose').onclick=$('#cancelModal').onclick=()=>$('#modalback').style.display='none';$('#exportBtn').onclick=()=>{let a=document.createElement('a'),blob=new Blob([JSON.stringify(db,null,2)],{type:'application/json'});a.href=URL.createObjectURL(blob);a.download='IAMS_backup.json';a.click();URL.revokeObjectURL(a.href)};
