    });
    if(k.calcType==='درصد پوشش')return series.length?Math.round(series.filter(v=>v>0).length/series.length*100):0;
    if(k.calcType==='میانگین')return series.length?Math.round(series.reduce((a,v)=>a+v,0)/series.length):0;
    if(k.calcType==='مد')return series.length?series.slice().sort((a,b)=>a-b)[Math.floor(series.length/2)]:0;
