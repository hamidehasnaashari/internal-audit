assessment=function(){let p=P();return `${header('ارزیابی خطر ذاتی پروژه','ماشین‌حساب در هر ردیف ریسک قرار دارد و چک‌لیست عوامل ریسک و احتمال و اثر را برای همان ریسک ثبت می‌کند.','<button id="addProjectObjective">+ افزودن هدف</button> <button id="addProjectRisk">+ افزودن ریسک</button>')}<div class="notice">عوامل ریسک، احتمال و اثر برای هر ریسک به‌صورت مستقل تکمیل می‌شوند. کنترل‌ها در ارزیابی خطر ذاتی دخالت داده نمی‌شوند. ارزیابی کنترل تنها در برنامه آزمون ثبت خواهد شد.</div>${table(['ریسک / هدف','احتمال','اثر','خطر ذاتی','ماشین‌حساب عوامل','نمایش','کاربرگ'],p.risks.map(r=>{let s=v14RiskStats(r);return `<tr><td><b>${v14esc(risk(r.id)?.name||r.id)}</b><div class="subtle">${v14esc(obj(r.obj)?.name||r.obj)}</div></td><td><select data-risk="${r.id}" data-rfield="l">${[1,2,3,4,5].map(n=>`<option ${n==r.l?'selected':''}>${n}</option>`).join('')}</select></td><td><select data-risk="${r.id}" data-rfield="i">${[1,2,3,4,5].map(n=>`<option ${n==r.i?'selected':''}>${n}</option>`).join('')}</select></td><td>${v14RiskScoreTag(s.inherentScore)}</td><td><button class="secondary" data-calcrisk="${r.id}">▦ ماشین‌حساب ریسک</button></td><td>${v14DetailsButton('projectrisk',p.id+'|'+r.id)}</td><td><button class="secondary" data-wpfor="risk:${r.id}">+ کاربرگ</button></td></tr>`} ))}<div class="sectionhead"><div><h2>اهداف انتخاب‌شده در پروژه</h2><p>هر هدف به ریسک‌های اختصاص‌یافته و چک‌لیست‌های آن‌ها مرتبط است.</p></div></div>${table(['هدف / شرح اختصاصی','دامنه','تعداد ریسک','میانگین عوامل','نمایش'],p.objectives.map(o=>{let rs=p.risks.filter(r=>r.obj===o.id);let av=rs.flatMap(r=>Object.values(r.answers||{})).filter(Number.isFinite);return `<tr><td><b>${v14esc(obj(o.id)?.name||o.id)}</b><div class="subtle">${v14esc(o.desc)}</div></td><td>${v14esc(o.scope||'—')}</td><td>${rs.length}</td><td>${av.length?(av.reduce((a,b)=>a+b,0)/av.length).toFixed(1)+'/۵':'—'}</td><td>${v14DetailsButton('objectiveproject',o.id+'|'+p.id)}</td></tr>`}))}`};
riskmatrix=function(){let p=P();let rr=p.risks.map(r=>{let s=v14RiskStats(r);return `<tr><td><b>${v14esc(obj(r.obj)?.name||r.obj)}</b></td><td>${v14esc(risk(r.id)?.name||r.id)}</td><td>${v14RiskScoreTag(s.inherentScore)}<div class="subtle">${r.l}×${r.i}</div></td><td>${s.controlRisk===null?'<span class="tag">ارزیابی نشده</span>':`${s.controlRisk}/۵`}</td><td>${v14RiskScoreTag(s.residualScore)}<div class="subtle">${s.residualL}×${s.residualI}</div></td><td>${v14DetailsButton('projectrisk',p.id+'|'+r.id)}</td></tr>`});return `${header('ماتریس اهداف و ریسک‌های پروژه','ارزیابی خطر ذاتی و باقیمانده به تفکیک هدف و ریسک؛ بدون نمایش امتیاز کنترل به‌عنوان خطر ذاتی')}<div class="grid cols"><div class="card"><b>نقشه حرارتی خطر ذاتی</b>${heatmap(p.risks.map(r=>({l:r.l,i:r.i})))}</div><div class="card"><b>نقشه حرارتی خطر باقیمانده</b>${heatmap(p.risks.map(r=>{let s=v14RiskStats(r);return {l:s.residualL,i:s.residualI}}))}</div></div>${table(['هدف','ریسک','خطر ذاتی','ریسک کنترل','خطر باقیمانده','نمایش'],rr)}<div class="notice">روش نمونه: خطر ذاتی = احتمال × اثر. امتیاز کنترل ریسک = ۶ منهای میانگین امتیاز طراحی، استقرار و اثربخشی آزمون‌های مرتبط. ریسک باقیمانده فقط در بُعدی کاهش می‌یابد که کنترل مرتبط آن بُعد را پوشش دهد. ضریب کاهش حداکثر ۶۰٪ و امتیازدهی باید با روش مصوب سازمان جایگزین یا کالیبره شود.</div>`};
rcm=function(){let p=P(),risksIn=p.risks,controlsIn=p.controls;let head=['ریسک / هدف',...controlsIn.map(c=>control(c.id)?.code||c.id),'تعداد کنترل','نمایش'];let rows=risksIn.map(r=>{const cells=controlsIn.map(c=>{let mc=control(c.id),mapped=(c.risks||mc?.risks||[]).includes(r.id);if(!mapped)return '<td class="matrixcell"><span class="matrixno">—</span></td>';let effect=[(c.prob??mc?.prob)?'احتمال':'',(c.impact??mc?.impact)?'اثر':''].filter(Boolean).join(' + ');return `<td class="matrixcell"><span class="matrixyes">✓</span><span class="matriximpact">${effect||'مرتبط'}</span></td>`}).join('');return `<tr><td><b>${v14esc(risk(r.id)?.name||r.id)}</b><div class="subtle">${v14esc(obj(r.obj)?.name||r.obj)}</div></td>${cells}<td>${v14riskControls(r.id).length}</td><td>${v14DetailsButton('projectrisk',p.id+'|'+r.id)}</td></tr>`});return `${header('ماتریس گرافیکی ریسک ـ کنترل','نمایش چندبه‌چند ارتباط ریسک‌ها و کنترل‌های انتخاب‌شده در پروژه؛ این ماتریس محل ارزیابی کنترل نیست.','<button id="addProjectControl">+ افزودن کنترل از مخزن</button>')}<div class="notice">علامت ✓ نشان می‌دهد کنترل برای ریسک انتخاب شده است. برچسب داخل سلول مشخص می‌کند کنترل بر احتمال وقوع یا شدت اثر تمرکز دارد. ارزیابی طراحی، استقرار و اثربخشی فقط در برنامه آزمون ثبت می‌شود.</div>${table(head,rows)}<div class="sectionhead"><div><h2>کنترل‌های انتخاب‌شده برای پروژه</h2><p>اطلاعات پایه و ارتباطات ثبت‌شده از مخزن سازمانی</p></div></div>${table(['کنترل','ریسک‌های مرتبط','اثر مورد انتظار','وضعیت آزمون','نمایش'],controlsIn.map(c=>{let mc=control(c.id),st=v14ControlStatus(c.id);return `<tr><td><b>${v14esc(mc?.name||c.name||c.id)}</b><div class="subtle">${v14esc(mc?.code||c.id)}</div></td><td>${(c.risks||[]).map(id=>v14esc(risk(id)?.name||id)).join('، ')}</td><td>${c.prob?'کاهش احتمال ':''}${c.impact?'کاهش اثر':''}</td><td>${st.count?`${st.count} ارزیابی در برنامه آزمون`:'فاقد ارزیابی آزمون'}</td><td>${v14DetailsButton('controlproject',p.id+'|'+c.id)}</td></tr>`}))}`};
program=function(){let p=P();return `${header('برنامه آزمون کنترل‌های داخلی','در این قسمت آزمون‌ها تعریف و ارزیابی طراحی، اعمال و اثربخشی کنترل ثبت می‌شود.','<button id="generatePrograms">✦ تولید برنامه ریسک‌محور</button> <button id="addProgram">+ آزمون دستی</button>')}<div class="notice">ارزیابی کنترل از مخزن و ماتریس حذف شده است. هر ارزیابی باید به آزمون، ریسک و کنترل مشخص متصل باشد و شواهد و نتیجه‌گیری داشته باشد.</div>${table(['هدف / ریسک / کنترل','روش آزمون و معیار','جامعه / نمونه','مسئول / موعد','وضعیت آزمون','ارزیابی کنترل','کاربرگ / نمایش'],p.programs.map(t=>{let ev=p.controlEvaluations.filter(e=>e.programId===t.id).slice(-1)[0];return `<tr><td><b>${v14esc(obj(t.obj)?.name||t.obj||'—')}</b><div>${v14esc(risk(t.risk)?.name||t.risk)}</div><div class="subtle">${v14esc(control(t.control)?.name||t.control)}</div></td><td>${v14esc(t.procedure)}<div class="subtle">معیار: ${v14esc(t.criteria||'—')}</div></td><td>${v14esc(t.population||'—')}<br>${v14esc(t.sampling||'—')} · ${v14esc(t.sample||'—')}</td><td>${v14esc(t.auditor||'—')}<br>${v14esc(t.due||'—')}</td><td><span class="tag">${v14esc(t.status||'برنامه‌ریزی‌شده')}</span></td><td>${ev?`طراحی ${ev.design}/۵ · اعمال ${ev.implementation}/۵ · اثربخشی ${ev.operating}/۵`:'<span class="tag med">ارزیابی نشده</span>'}<br><button class="secondary" data-evaluate="${t.id}">${ev?'به‌روزرسانی ارزیابی':'ثبت ارزیابی کنترل'}</button></td><td><button class="secondary" data-wpfor="test:${t.id}">+ کاربرگ</button> ${v14DetailsButton('program',t.id)}</td></tr>`}))}${header('ارزیابی‌های منتقل‌شده یا فاقد برنامه آزمون','این موارد باید به یک آزمون معتبر متصل و توسط حسابرس بازبینی شوند.')}${table(['کنترل','ریسک','امتیاز طراحی','اعمال','اثربخشی','وضعیت','نمایش'],p.controlEvaluations.filter(e=>!e.programId).map(e=>`<tr><td>${v14esc(control(e.control)?.name||e.control)}</td><td>${v14esc(risk(e.risk)?.name||e.risk||'—')}</td><td>${e.design}/۵</td><td>${e.implementation}/۵</td><td>${e.operating}/۵</td><td><span class="tag med">${v14esc(e.status||'نیازمند بازبینی')}</span></td><td>${v14DetailsButton('controleval',e.id)}</td></tr>`))}`};
workpapers=function(){let p=P();return `${header('کاربرگ‌ها و شواهد پروژه','هر کاربرگ به ارزیابی ریسک، آزمون کنترل یا ارزیابی کنترل مشخص متصل است.','<button id="addWorkpaper">+ کاربرگ جدید</button>')}${table(['شناسه / عنوان','نوع اتصال','شرح کار','شواهد و استثنا','نتیجه','تهیه‌کننده / بازبین','وضعیت / نمایش'],p.workpapers.map(w=>`<tr><td><b>${v14esc(w.id)} · ${v14esc(w.title)}</b></td><td>${v14esc(w.link||'—')}</td><td>${v14esc(w.work||'—')}</td><td>${v14esc(w.evidence||'—')}<div class="subtle">استثنا: ${v14esc(w.exceptions||'ندارد')}</div></td><td>${v14esc(w.conclusion||'—')}</td><td>${v14esc(w.preparer||'—')} / ${v14esc(w.reviewer||'—')}</td><td><span class="tag">${v14esc(w.status||'—')}</span> ${v14DetailsButton('workpaper',w.id)}</td></tr>`))}`};
findings=function(){let p=P();return `${header('یافته‌های حسابرسی','هر یافته می‌تواند به ریسک، کنترل، هدف و کاربرگ متصل شود.','<button id="addFinding">+ ثبت یافته</button>')}${table(['یافته','ارتباط با ریسک / کنترل','شرایط / معیار / علت / اثر','شدت / مالک','اقدامات مرتبط','نمایش'],p.findings.map(f=>`<tr><td><b>${v14esc(f.title)}</b><div class="subtle">${v14esc(f.id)} · ${v14esc(f.wp||'بدون کاربرگ')}</div></td><td>${v14esc(risk(f.risk)?.name||f.risk||'—')}<br>${v14esc(control(f.control)?.name||f.control||'—')}</td><td>شرایط: ${v14esc(f.condition||'—')}<br>معیار: ${v14esc(f.criteria||'—')}<br>علت: ${v14esc(f.cause||'—')}<br>اثر: ${v14esc(f.effect||'—')}</td><td><span class="tag ${f.severity==='زیاد'?'high':f.severity==='متوسط'?'med':'low'}">${v14esc(f.severity||'—')}</span><br>${v14esc(f.owner||'—')}</td><td>${p.actions.filter(a=>a.finding===f.id).map(a=>v14esc(a.title)+' ('+v14esc(a.status)+')').join('<hr>')||'—'}</td><td>${v14DetailsButton('finding',f.id)}</td></tr>`))}`};
remediation=function(){let p=P();let atRisk=p.findings.filter(f=>{let r=projectRisk(f.risk);let s=r?v14RiskStats(r):null;let ev=f.control?p.controlEvaluations.filter(e=>e.control===f.control&&!!e.programId):[];let avg=v14avg(ev.map(v14evalRating));return f.severity==='زیاد'||(s&&s.residualScore>=16)||(avg!==null&&avg<3)});return `${header('برنامه اقدامات اصلاحی','اقدامات برای یافته‌های بااهمیت، ریسک باقیمانده بالا یا ضعف کنترل داخلی تدوین و پایش می‌شوند.','<button id="generateActions">✦ پیشنهاد اقدامات برای موارد پرخطر</button> <button id="addAction">+ اقدام دستی</button>')}<div class="notice">پیشنهاد خودکار بر اساس یافته با شدت زیاد، ریسک باقیمانده ۱۶/۲۵ یا بیشتر، یا امتیاز میانگین کنترل کمتر از ۳/۵ ارائه می‌شود. این پیشنهاد rule-based است و باید توسط مدیر حسابرسی و مالک اقدام تأیید شود.</div>${table(['یافته / ارتباط','شاخص محرک','شدت / وضعیت','پیشنهاد اقدام','عملیات'],atRisk.map(f=>{let r=projectRisk(f.risk),s=r?v14RiskStats(r):null,ev=p.controlEvaluations.filter(e=>e.control===f.control&&!!e.programId),avg=v14avg(ev.map(v14evalRating));return `<tr><td><b>${v14esc(f.title)}</b><div class="subtle">${v14esc(f.risk||'—')} / ${v14esc(f.control||'—')}</div></td><td>${f.severity==='زیاد'?'یافته با شدت زیاد ':''}${s?'ریسک باقیمانده '+s.residualScore+'/۲۵ ':''}${avg!==null?'میانگین کنترل '+avg.toFixed(1)+'/۵':''}</td><td><span class="tag high">نیازمند اقدام</span></td><td>${v14esc(f.recommendation||'تدوین اقدام اصلاحی برای رفع علت ریشه‌ای و تقویت کنترل')}</td><td>${v14DetailsButton('finding',f.id)}</td></tr>`}))}${header('دفتر برنامه اقدامات اصلاحی','مالک، موعد، اولویت، پیشرفت، شواهد و وضعیت اقدامات')}${table(['اقدام','یافته','مالک','موعد','اولویت','پیشرفت','وضعیت','نمایش'],p.actions.map(a=>`<tr><td><b>${v14esc(a.title)}</b><div class="subtle">${v14esc(a.id)}</div></td><td>${v14esc(a.finding||'—')}</td><td>${v14esc(a.owner||'—')}</td><td>${v14esc(a.due||'—')}</td><td>${v14esc(a.priority||'—')}</td><td><input type="number" min="0" max="100" value="${+a.progress||0}" data-progress="${a.id}" style="width:65px">٪</td><td><select data-actionstatus="${a.id}">${['پیشنهادی','باز','در حال اجرا','آماده بررسی','بسته'].map(s=>`<option ${a.status===s?'selected':''}>${s}</option>`).join('')}</select></td><td>${v14DetailsButton('action',a.id)}</td></tr>`))}`};
followup=function(){let p=P();return `${header('پیگیری و بستن اقدامات','ثبت بررسی مجدد، شواهد، نتیجه و تصمیم درباره بستن یا بازگشایی اقدام','<button id="addFollowup">+ ثبت پیگیری</button>')}${table(['اقدام','تاریخ','پیگیر','نتیجه آزمون مجدد','شرح / شواهد','تصمیم','نمایش'],p.followups.map((f,i)=>`<tr><td>${v14esc(p.actions.find(a=>a.id===f.action)?.title||f.action)}</td><td>${v14esc(f.date||'—')}</td><td>${v14esc(f.reviewer||'—')}</td><td>${v14esc(f.result||'—')}</td><td>${v14esc(f.notes||'—')}</td><td><span class="tag">${v14esc(f.decision||'—')}</span></td><td>${v14DetailsButton('followup',String(i))}</td></tr>`))}`};

function v14RiskCalculator(rid){let r=projectRisk(rid);if(!r)return;const master=risk(rid),factors=(checklist||[]).map(([k,l])=>`<div class="field"><label>${v14esc(l)} (۱ تا ۵)</label><select name="${k}">${[1,2,3,4,5].map(n=>`<option value="${n}" ${+(r.answers?.[k]||3)===n?'selected':''}>${n}</option>`).join('')}</select><input name="why_${k}" placeholder="دلیل / شاهد این عامل" value="${v14esc(r.factorNotes?.[k]||'')}"></div>`).join('');const stats=v14RiskStats(r);modal('ماشین‌حساب خطر ذاتی · '+(master?.name||rid),`<div class="notice">این چک‌لیست فقط برای ریسک انتخاب‌شده است. امتیاز عوامل، مبنای قضاوت حسابرس برای احتمال و اثر است؛ کنترل‌ها در محاسبه خطر ذاتی دخالت ندارند.</div><div class="formgrid">${factors}${field('l','احتمال وقوع ذاتی (۱ تا ۵)',r.l,'number')}${field('i','شدت اثر ذاتی (۱ تا ۵)',r.i,'number')}<div class="wide notice">امتیاز فعلی خطر ذاتی: ${stats.inherentScore}/۲۵ · کنترل ریسک: ${stats.controlRisk===null?'ارزیابی نشده':stats.controlRisk+'/۵'} · باقیمانده: ${stats.residualScore}/۲۵</div>${field('rationale','مبنای ارزیابی و جمع‌بندی حسابرس',r.rationale||'','textarea',true)}</div>`,v=>{r.answers=r.answers||{};r.factorNotes=r.factorNotes||{};(checklist||[]).forEach(([k])=>{r.answers[k]=+v[k];r.factorNotes[k]=v['why_'+k]||''});r.l=Math.max(1,Math.min(5,+v.l||1));r.i=Math.max(1,Math.min(5,+v.i||1));r.rationale=v.rationale||'';});}
function v14EditControlEval(tid){let t=P().programs.find(x=>x.id===tid);if(!t)return;let e=P().controlEvaluations.filter(x=>x.programId===tid).slice(-1)[0];let vals=e||{design:3,implementation:3,operating:3,evidence:'',rationale:'',status:'ارزیابی اولیه'};modal('ارزیابی کنترل در برنامه آزمون',`<div class="notice">کنترل: ${v14esc(control(t.control)?.name||t.control)} · ریسک: ${v14esc(risk(t.risk)?.name||t.risk)}. این تنها محل ثبت ارزیابی طراحی، استقرار و اثربخشی کنترل است.</div><div class="formgrid">${field('design','کفایت طراحی (۱ تا ۵)',vals.design,'number')}${field('implementation','اعمال / استقرار (۱ تا ۵)',vals.implementation,'number')}${field('operating','اثربخشی عملیاتی (۱ تا ۵)',vals.operating,'number')}${field('evidence','شواهد و نمونه‌های آزمون‌شده',vals.evidence||'','textarea',true)}${field('rationale','استدلال، استثناها و نتیجه‌گیری حسابرس',vals.rationale||'','textarea',true)}${field('status','وضعیت ارزیابی','تکمیل‌شده','select',false,['در حال بررسی','تکمیل‌شده','ناموفق','نیازمند بازبینی'].map(x=>[x,x]))}</div>`,v=>{if(e){Object.assign(e,{design:+v.design,implementation:+v.implementation,operating:+v.operating,evidence:v.evidence,rationale:v.rationale,status:v.status});}else{P().controlEvaluations.push({id:'CE-'+uid(),programId:t.id,control:t.control,risk:t.risk,design:+v.design,implementation:+v.implementation,operating:+v.operating,evidence:v.evidence,rationale:v.rationale,status:v.status})}})}
function v14Details(type,id){let title='نمایش جزئیات',content='';const p=P();if(type==='riskmaster'){let r=risk(id);title='جزئیات ریسک سازمانی';content=`<h3>${v14esc(r?.name||id)}</h3><p>${v14esc(r?.desc||'')}</p><p>علل: ${v14esc(r?.causes||'—')}<br>پیامد: ${v14esc(r?.effect||'—')}</p><p>اهداف: ${(r?.obj||[]).map(x=>v14esc(obj(x)?.name||x)).join('، ')}</p>`}
else if(type==='controlmaster'){let c=control(id);title='جزئیات کنترل سازمانی';content=`<h3>${v14esc(c?.name||id)}</h3><p>${v14esc(c?.desc||'')}</p><p>نوع: ${v14esc(c?.type||'—')} · ماهیت: ${v14esc(c?.nature||'—')} · تناوب: ${v14esc(c?.freq||'—')}</p><p>اثر مورد انتظار: ${c?.prob?'کاهش احتمال ':''}${c?.impact?'کاهش اثر':''}</p><p>ریسک‌ها: ${(c?.risks||[]).map(x=>v14esc(risk(x)?.name||x)).join('، ')}</p>`}
else if(type==='projectrisk'){let [pid,rid]=id.split('|');let pr=db.projects.find(x=>x.id===pid)||p,r=pr.risks.find(x=>x.id===rid),s=v14RiskStats(r,pr);let m=risk(rid);title='جزئیات ریسک پروژه';content=`<h3>${v14esc(m?.name||rid)}</h3><p>${v14esc(m?.desc||'')}</p><p>هدف: ${v14esc(obj(r?.obj)?.name||r?.obj)}<br>احتمال: ${r?.l} · اثر: ${r?.i}<br>خطر ذاتی: ${s.inherentScore}/۲۵<br>ریسک کنترل: ${s.controlRisk===null?'ارزیابی نشده':s.controlRisk+'/۵'}<br>خطر باقیمانده: ${s.residualScore}/۲۵ (${s.residualL}×${s.residualI})</p><p>مبنای ارزیابی: ${v14esc(r?.rationale||'—')}</p>${r?.answers?`<p>میانگین عوامل چک‌لیست: ${(Object.values(r.answers).reduce((a,b)=>a+(+b),0)/Math.max(1,Object.keys(r.answers).length)).toFixed(1)} از ۵</p>`:''}${heatmap([{l:r?.l||1,i:r?.i||1}])}`}
else if(type==='objectiveproject'){let [oid,pid]=id.split('|'),pr=db.projects.find(x=>x.id===pid)||p,met=v14objectiveMetrics(oid,pr);title='نمایش هدف در پروژه';content=`<h3>${v14esc(obj(oid)?.name||oid)}</h3><p>پروژه: ${v14esc(pr.name)}<br>شرح اختصاصی: ${v14esc(pr.objectives.find(x=>x.id===oid)?.desc||'—')}<br>تعداد ریسک: ${met.risks}<br>تعداد کنترل: ${met.controls}<br>بالاترین خطر باقیمانده: ${met.residual||'—'}</p>${table(['ریسک','خطر ذاتی','خطر باقیمانده'],met.rs.map(r=>{let s=v14RiskStats(r,pr);return `<tr><td>${v14esc(risk(r.id)?.name||r.id)}</td><td>${s.inherentScore}</td><td>${s.residualScore}</td></tr>`}))}`}
else if(type==='controlproject'){let [pid,cid]=id.split('|'),pr=db.projects.find(x=>x.id===pid)||p,c=pr.controls.find(x=>x.id===cid),ev=pr.controlEvaluations.filter(x=>x.control===cid);title='کنترل انتخاب‌شده در پروژه';content=`<h3>${v14esc(control(cid)?.name||cid)}</h3><p>پروژه: ${v14esc(pr.name)}<br>ریسک‌های مرتبط: ${(c?.risks||[]).map(x=>v14esc(risk(x)?.name||x)).join('، ')}</p><p>ارزیابی‌ها فقط در برنامه آزمون انجام می‌شوند. تعداد ارزیابی ثبت‌شده: ${ev.length}</p>`}
